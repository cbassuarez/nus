+/// An ordered mailbox is shared by every window in this process/profile. A
+/// disconnected client does not cancel an already accepted durable operation.
+#[derive(Clone)]
+pub struct Service { tx: mpsc::SyncSender<(Command,mpsc::Sender<Result<Reply>>)>, }
+impl Service {
+    pub fn at(root:PathBuf)->Self {
+        let (tx,rx)=mpsc::sync_channel::<(Command,mpsc::Sender<Result<Reply>>)>(64);
+        std::thread::spawn(move || {
+            let mut store:Option<Store>=None;
+            for (command,reply) in rx {
+                if store.is_none() {
+                    match Store::open(root.clone()) {
+                        Ok(s)=>store=Some(s),
+                        Err(e)=>{let _=reply.send(Err(format!("Reading storage is unavailable: {e}")));continue;}
+                    }
+                }
+                let result=store.as_mut().unwrap().execute(command);
+                let _=reply.send(result);
+            }
+        });
+        Self{tx}
+    }
+    /// Return the command on backpressure so final capture results can retry
+    /// without losing their ticket or retaining an unbounded series of copies.
+    pub fn submit_recover(&self,command:Command)->std::result::Result<mpsc::Receiver<Result<Reply>>,(Command,String)> {
+        let (tx,rx)=mpsc::channel();
+        match self.tx.try_send((command,tx)) {
+            Ok(())=>Ok(rx),
+            Err(mpsc::TrySendError::Full((command,_)))=>Err((command,"Reading List is busy; try again".into())),
+            Err(mpsc::TrySendError::Disconnected((command,_)))=>Err((command,"Reading List worker stopped".into())),
+        }
+    }
+    pub fn submit(&self,command:Command)->Result<mpsc::Receiver<Result<Reply>>> {
+        self.submit_recover(command).map_err(|(_,error)|error)
+    }
+    pub fn flush(&self)->Result<()> {
+        match self.submit(Command::Barrier)?.recv_timeout(Duration::from_secs(5)) {
+            Ok(Ok(Reply::Barrier))=>Ok(()),
+            Ok(Err(e))=>Err(e),
+            _=>Err("Reading changes have not finished saving".into()),
+        }
+    }
+}
+/// Profile choice is made by the caller after private-mode gating. This function
+/// never discovers a profile, changes working directories, or enables syncing.
+pub fn service(root:PathBuf)->Result<Service> {
+    static SERVICES:OnceLock<Mutex<HashMap<PathBuf,Service>>>=OnceLock::new();
+    let mut services=SERVICES.get_or_init(||Mutex::new(HashMap::new())).lock().map_err(|_|"Reading service lock failed".to_string())?;
+    Ok(services.entry(root.clone()).or_insert_with(||Service::at(root)).clone())
+}
