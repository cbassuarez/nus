+/// Locate a quotation across new line wrapping, returning its UTF-8 byte offset.
+/// Ambiguous quotes are not silently resolved to an arbitrary repeated passage.
+pub fn locate_quote(text:&str,p:&Position)->Option<usize> {
+    if p.quote.is_empty() { return None; }
+    let mut hits=text.match_indices(&p.quote).filter(|(i,_)| {
+        (p.before.is_empty()||text[..*i].ends_with(&p.before)) && (p.after.is_empty()||text[*i+p.quote.len()..].starts_with(&p.after))
+    });
+    let first=hits.next()?.0;
+    if hits.next().is_some(){None}else{Some(first)}
+}
