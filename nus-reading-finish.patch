+#!/usr/bin/env python3
+"""Native reading regression driver, for a BUILT macOS nus.app.
+
+Uses the application's real command, capture, renderer, and screenshot paths.
+No installed profile is read or modified. Network fixtures stay on loopback.
+Not a substitute for VoiceOver/manual interaction or other-platform builds.
+Usage: python3 scripts/check-reading.py dist/nus.app
+"""
+from __future__ import annotations
+import argparse
+import json
+import os
+import subprocess
+import tempfile
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+CODE = 'function example() {\n\treturn "exact spacing";  \n}\n'
+
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument('bundle',type=Path);args=ap.parse_args()
+    exe=args.bundle.resolve()/'Contents/MacOS/nus'
+    if not exe.is_file():raise SystemExit(f'Built macOS executable not found: {exe}')
+    root=Path(tempfile.mkdtemp(prefix='nus-reading-check-'))
+    profile=root/'profile';profile.mkdir()
+    (profile/'onboarded').write_text('skip')
+    (profile/'settings.json').write_text(json.dumps({'behavior':{'then':'Prompt','splash':'None','atlas':'Planet','remember':False},'motion':{'reduce':True}}))
+    # Native fixture image is a supplied, valid 160x80 PNG, not an HTTP dependency.
+    png_path=Path(__file__).parent/'reading-check/figure.png.hex'
+    image=bytes.fromhex(png_path.read_text())
+    paragraphs=''.join(f'<h2>Passage {i}</h2><p>Paragraph {i}. This is a saved reading regression article. It contains enough text to exercise reflow, paragraph anchors and scrolling without using an external website.</p>' for i in range(35))
+    article=('<!doctype html><meta charset="utf-8"><title>Reading acceptance</title><article><h1>Reading acceptance</h1>'+paragraphs+'<pre>'+CODE+'</pre><img src="/figure.png" alt="Saved figure"><table><tr><th>Name</th><th>Value</th></tr><tr><td>Alpha</td><td>42</td></tr></table></article>').encode()
+    requests=[]
+    class Handler(BaseHTTPRequestHandler):
+        def do_GET(self):
+            requests.append(self.path);body,mime=(image,'image/png') if self.path=='/figure.png' else (article,'text/html; charset=utf-8')
+            self.send_response(200);self.send_header('Content-Type',mime);self.send_header('Content-Length',str(len(body)));self.end_headers();self.wfile.write(body)
+        def log_message(self,*_):pass
+    server=ThreadingHTTPServer(('127.0.0.1',0),Handler);server.daemon_threads=True
+    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()
+    url=f'http://127.0.0.1:{server.server_port}/article?q=1#section'
+    def run(name,steps):
+        script=root/f'{name}.shot';script.write_text('wait 2500\n'+steps+'\n')
+        out=root/name;out.mkdir(exist_ok=True)
+        env=dict(os.environ,NUS_SHOT_DIR=str(root),NUS_SHOT=str(script),NUS_SHOT_OUT=str(out),NUS_MODE='paper')
+        env.pop('NUS_SHOT2',None)
+        log=root/f'{name}.log'
+        with log.open('w') as f:
+            result=subprocess.run([str(exe)],cwd=root,env=env,stdout=f,stderr=subprocess.STDOUT,timeout=90)
+        text=log.read_text()
+        if result.returncode or 'panicked' in text or 'READING_CHECK_COMPLETE' not in text:
+            raise RuntimeError(f'{name} failed or incomplete; inspect {log}\n{text[-3500:]}')
+        print('PASS',name,flush=True)
+    try:
+        run('capture',f'''tab {url}
+wait 3500
+reading save
+wait 12000
+reading open
+wait 1500
+reading assert-count 1
+reading assert-idle
+reading assert-offline
+reading assert-bounds
+reading assert-access
+shot reading-list
+reading select 0
+reading open-selected
+wait 1500
+reading assert-reader
+reading assert-images 1
+reading assert-code {json.dumps(CODE)}
+reading assert-contains Alpha
+reading scroll 800
+wait 1500
+reading flush
+wait 1500
+shot saved-reading
+reading close-source
+wait 1500
+reading open
+wait 1500
+reading select 0
+reading open-selected
+wait 1500
+reading assert-browsers 0
+reading assert-position
+reading assert-contains Reading acceptance
+reading complete''')
+    finally:
+        server.shutdown();server.server_close();thread.join()
+    count=len(requests)
+    # There is now NO fixture server. No original page should reopen automatically.
+    run('offline-relaunch','''reading open
+wait 1500
+reading assert-count 1
+reading select 0
+reading open-selected
+wait 1500
+reading assert-reader
+reading assert-browsers 0
+reading assert-images 1
+reading assert-position
+reading find Paragraph 20
+reading assert-find
+reading assert-access
+reading assert-bounds
+shot offline-resume
+reading back
+wait 400
+reading click remove-selected
+wait 300
+reading click cancel
+wait 300
+reading assert-count 1
+reading click archive-selected
+wait 1500
+reading click filter:3
+wait 400
+reading assert-matches 1
+reading click archive-selected
+wait 1500
+reading click filter:1
+wait 400
+reading assert-matches 1
+reading click remove-selected
+wait 300
+reading click confirm
+wait 1500
+reading assert-count 0
+reading click undo
+wait 1500
+reading assert-count 1
+reading complete''')
+    assert len(requests)==count
+    print(f'Evidence: {root}\nReview the screenshots; a scripted pass is not visual acceptance.')
+if __name__=='__main__':main()
