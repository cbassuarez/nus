+/// Store methods are used only by the writer thread (or isolated unit tests).
+pub struct Store {
+    root: PathBuf,
+    entries: BTreeMap<String, Entry>,
+    tickets: HashMap<String,String>,
+    warnings: Vec<String>,
+    revision: u64,
+    fingerprints: HashMap<String,String>,
+    #[cfg(test)]
+    fail_before_object: bool,
+    #[cfg(test)]
+    fail_before_entry: bool,
+}
+impl Store {
+    pub fn open(root: PathBuf) -> Result<Self> {
+        for dir in [&root, &root.join("entries"), &root.join("objects")] {
+            fs::create_dir_all(dir).map_err(error)?;
+            let meta=fs::symlink_metadata(dir).map_err(error)?;
+            if meta.file_type().is_symlink() || !meta.is_dir() {return Err("Reading storage must be real directories".into());}
+            #[cfg(unix)] {
+                use std::os::unix::fs::PermissionsExt;
+                fs::set_permissions(dir, fs::Permissions::from_mode(0o700)).map_err(error)?;
+            }
+        }
+        let mut s=Self{root,entries:BTreeMap::new(),tickets:HashMap::new(),warnings:vec![],revision:1,fingerprints:HashMap::new(),
+            #[cfg(test)] fail_before_object:false, #[cfg(test)] fail_before_entry:false};
+        for (scanned,item) in fs::read_dir(s.root.join("entries")).map_err(error)?.enumerate() {
+            if scanned>MAX_ENTRIES+1024 {return Err("Too many reading records; no files were changed".into());}
+            let item=item.map_err(error)?;
+            let p=item.path();
+            if p.extension().and_then(|e|e.to_str())!=Some("json") {continue;}
+            if s.entries.len()>=MAX_ENTRIES {return Err("Reading List entry limit reached; no files were changed".into());}
+            let read: Result<(Entry,String)> = (|| {
+                let bytes=read_limited(&p,MAX_RECORD)?;
+                let e: Entry=serde_json::from_slice(&bytes).map_err(error)?;
+                Self::validate_entry(&e)?;
+                if p.file_stem().and_then(|s|s.to_str())!=Some(e.id.as_str()) {return Err("Entry identity does not match its filename".into());}
+                Ok((e,digest(&bytes)))
+            })();
+            match read {
+                Ok((e,fingerprint))=>{s.fingerprints.insert(e.id.clone(),fingerprint);s.entries.insert(e.id.clone(),e);},
+                Err(_)=>s.warnings.push(format!("{} could not be read. It was preserved unchanged.",p.file_name().unwrap_or_default().to_string_lossy())),
+            }
+        }
+        Ok(s)
+    }
+    fn validate_entry(e:&Entry)->Result<()> {
+        if e.schema!=SCHEMA || !identifier(&e.id,32) || (e.revision==0 || e.revision==u64::MAX) {return Err("Unknown or invalid reading entry schema".into());}
+        page_url(&e.url)?;
+        if e.word_count.is_some_and(|n|n>MAX_TEXT) || e.missing_images.is_some_and(|n|n>MAX_BLOCKS){return Err("Invalid article summary".into());}
+        if !text_ok(&e.title,8192) || !text_ok(&e.container,512) {return Err("Invalid saved page metadata".into());}
+        if e.snapshot.as_ref().is_some_and(|s|!identifier(s,64)) {return Err("Invalid snapshot reference".into());}
+        if let Some(p)=&e.position { validate_position(p)?; }
+        if e.capture_error.as_ref().is_some_and(|s|!text_ok(s,2048)) {return Err("Invalid capture status".into());}
+        Ok(())
+    }
+    fn publish(&mut self,e:Entry)->Result<Entry> {
+        Self::validate_entry(&e)?;
+        let data=serde_json::to_vec(&e).map_err(error)?;
+        if data.len()>MAX_RECORD {return Err("Reading entry is too large".into());}
+        let path=self.root.join("entries").join(format!("{}.json",e.id));
+        // Detect out-of-band edits rather than overwriting a newer/different file.
+        if let Some(expected)=self.fingerprints.get(&e.id) {
+            let bytes=read_limited(&path,MAX_RECORD).map_err(|_|"Reading entry was changed or removed outside this process; restart to reload it".to_string())?;
+            if digest(&bytes)!=*expected{return Err("Reading entry changed outside this process; its file was left untouched. Restart to reload it.".into());}
+        } else if path.exists(){return Err("Reading entry filename already exists; nothing was overwritten".into());}
+        #[cfg(test)]
+        if self.fail_before_entry{return Err("injected: before entry publication".into());}
+        // Re-read after an error following rename, so an uncertain durability
+        // result cannot leave memory older than the file just published.
+        if let Err(err)=durable_write(&path,&data) {
+            if let Ok(bytes)=read_limited(&path,MAX_RECORD) {
+                if let Ok(on_disk)=serde_json::from_slice::<Entry>(&bytes) {
+                    if Self::validate_entry(&on_disk).is_ok() { self.fingerprints.insert(on_disk.id.clone(),digest(&bytes));self.entries.insert(on_disk.id.clone(),on_disk);self.revision+=1; }
+                }
+            }
+            return Err(err);
+        }
+        self.fingerprints.insert(e.id.clone(),digest(&data));self.entries.insert(e.id.clone(),e.clone());self.revision+=1;Ok(e)
+    }
+    pub fn listing(&self)->Listing {
+        let mut entries:Vec<_>=self.entries.values().filter(|e|!e.deleted).cloned().collect();
+        entries.sort_by(|a,b|b.saved_at.cmp(&a.saved_at).then_with(||a.id.cmp(&b.id)));
+        Listing{revision:self.revision,entries,warnings:self.warnings.clone(),busy:self.tickets.keys().cloned().collect()}
+    }
+    pub fn execute(&mut self,c:Command)->Result<Reply> {
+        match c {
+            Command::List=>Ok(Reply::List(self.listing())),
+            Command::ListSince(revision)=>if revision==self.revision {Ok(Reply::Unchanged)} else {Ok(Reply::List(self.listing()))},
+            Command::Save{url,title,container,refresh}=>self.save(url,title,container,refresh),
+            Command::Commit{ticket,capture}=>self.commit(ticket,&capture),
+            Command::Fail{ticket,reason}=>self.fail(ticket,&reason),
+            Command::Change{id,change}=>self.change(&id,change),
+            Command::Open{id}=>self.open_entry(&id),
+            Command::Barrier=>Ok(Reply::Barrier),
+        }
+    }
+    fn save(&mut self,url:String,title:String,container:String,refresh:bool)->Result<Reply> {
+        let url=page_url(&url)?;
+        if !text_ok(&title,8192)||!text_ok(&container,512) {return Err("Invalid saved page metadata".into());}
+        let found=self.entries.values().find(|e|!e.deleted && e.url==url && e.container==container).cloned();
+        let existed=found.is_some();
+        let mut e=match found {
+            Some(e)=>e,
+            None=>{
+                if self.entries.len()>=MAX_ENTRIES {return Err("Reading List entry limit reached".into());}
+                Entry{schema:SCHEMA,id:random_id()?,revision:1,url:url.clone(),container,title:if title.trim().is_empty(){url.clone()}else{title},saved_at:now(),updated_at:now(),read:ReadState::Unread,archived:false,snapshot:None,position:None,capture_error:None,deleted:false,word_count:None,missing_images:None}
+            }
+        };
+        if existed && !refresh {return Ok(Reply::Saved{entry:e,ticket:None,existed:true});}
+        if self.tickets.contains_key(&e.id) {return Err("A copy of this page is already being saved".into());}
+        if self.tickets.len()>=4{return Err("Four reading captures are already active in this profile".into());}
+        let generation=random_id()?;
+        e.capture_error=None;
+        if existed {e.revision+=1;e.updated_at=now();}
+        let e=self.publish(e)?;
+        let ticket=Ticket{id:e.id.clone(),generation:generation.clone(),url:e.url.clone()};
+        self.tickets.insert(e.id.clone(),generation);self.revision+=1;
+        Ok(Reply::Saved{entry:e,ticket:Some(ticket),existed})
+    }
+    fn valid_ticket(&self,t:&Ticket)->bool {
+        self.tickets.get(&t.id)==Some(&t.generation) && self.entries.get(&t.id).is_some_and(|e|!e.deleted && e.url==t.url)
+    }
+    fn commit(&mut self,t:Ticket,json:&str)->Result<Reply> {
+        if !self.valid_ticket(&t) {return Ok(Reply::Stale);}
+        let build: Result<Snapshot> = (|| {
+            if json.len()>MAX_CAPTURE {return Err("Capture exceeds the reading budget".into());}
+            let c:Capture=serde_json::from_str(json).map_err(|_|"Page returned an invalid capture".to_string())?;
+            if c.schema!=SCHEMA || c.token!=t.generation || page_url(&c.url)?!=t.url {return Err("The page changed while saving; the link is still saved".into());}
+            validate_document(&c.document)?;validate_media(&c.media)?;
+            validate_references(&c.document, &c.media, c.missing_images)?;
+            // Full PNG validation happens off the UI thread, before publication.
+            let _ = decode_images(&c.media)?;
+            if c.notices.len()>32 || c.notices.iter().any(|s|!text_ok(s,512)) || c.missing_images>MAX_BLOCKS {return Err("Invalid capture metadata".into());}
+            Ok(Snapshot{schema:SCHEMA,url:t.url.clone(),captured_at:now(),document:c.document,media:c.media,missing_images:c.missing_images,notices:c.notices})
+        })();
+        let snapshot=match build {Ok(s)=>s,Err(e)=>{return self.fail(t,&e);}};
+        let bytes=serde_json::to_vec(&snapshot).map_err(error)?;
+        if bytes.len()>MAX_CAPTURE {return self.fail(t,"Saved copy exceeds the reading budget");}
+        let hash=digest(&bytes);
+        let object=self.root.join("objects").join(format!("{hash}.json"));
+        // Immutable object first, record reference last. An interrupted save can
+        // leave an orphan, never a record referring to an unfinished object.
+        #[cfg(test)]
+        if self.fail_before_object{return self.fail(t,"injected: before object publication");}
+        if let Err(e)=durable_write(&object,&bytes) {return self.fail(t,&format!("Could not save article content: {e}"));}
+        let mut e=self.entries.get(&t.id).cloned().ok_or("Reading entry was removed")?;
+        e.snapshot=Some(hash);e.revision+=1;e.updated_at=now();e.capture_error=None;
+        e.missing_images=Some(snapshot.missing_images);
+        e.word_count=Some(snapshot.document["blocks"].as_array().into_iter().flatten().filter(|b|matches!(b["t"].as_str(),Some("p"|"li"|"q"|"pre"))).filter_map(|b|b["x"].as_str()).map(|x|x.split_whitespace().count()).sum());
+        if let Some(title)=snapshot.document.get("title").and_then(|v|v.as_str()).filter(|s|!s.trim().is_empty()) {e.title=title.into();}
+        // Keep the old anchor: quote matching deliberately crosses refreshed copies.
+        let result=self.publish(e);
+        self.tickets.remove(&t.id);self.revision+=1;
+        result.map(Reply::Committed)
+    }
+    fn fail(&mut self,t:Ticket,reason:&str)->Result<Reply> {
+        if !self.valid_ticket(&t) {return Ok(Reply::Stale);}
+        let mut e=self.entries.get(&t.id).cloned().ok_or("Reading entry was removed")?;
+        e.capture_error=Some(reason.chars().filter(|c|!c.is_control()).take(400).collect());
+        e.revision+=1;e.updated_at=now();
+        let result=self.publish(e);
+        self.tickets.remove(&t.id);self.revision+=1;
+        result.map(Reply::Changed)
+    }
+    fn change(&mut self,id:&str,change:Change)->Result<Reply> {
+        let mut e=self.entries.get(id).cloned().ok_or("Reading entry no longer exists")?;
+        if e.deleted && !matches!(change,Change::Restore) {return Ok(Reply::Stale);}
+        match change {
+            Change::Read(s)=>e.read=s,
+            Change::Archive(a)=>e.archived=a,
+            Change::Position(p)=>{
+                validate_position(&p)?;
+                // An old window must not attach its progress to a refreshed copy.
+                if e.snapshot.as_deref()!=Some(p.snapshot.as_str()) {return Ok(Reply::Stale);}
+                e.position=Some(p);
+                if e.read==ReadState::Unread {e.read=ReadState::InProgress;}
+            },
+            Change::Delete=>{e.deleted=true;},
+            Change::Restore=>e.deleted=false,
+        }
+        e.revision+=1;e.updated_at=now();
+        let e=self.publish(e)?;
+        if e.deleted {self.tickets.remove(id);self.revision+=1;}
+        Ok(Reply::Changed(e))
+    }
+    fn open_entry(&self,id:&str)->Result<Reply> {
+        let e=self.entries.get(id).filter(|e|!e.deleted).cloned().ok_or("Reading entry no longer exists")?;
+        let hash=e.snapshot.as_ref().ok_or("This entry has only a saved link, not an offline copy")?;
+        let bytes=read_limited(&self.root.join("objects").join(format!("{hash}.json")),MAX_CAPTURE)?;
+        if digest(&bytes)!=*hash {return Err("Saved copy failed its integrity check. The entry and original link were preserved.".into());}
+        let s:Snapshot=serde_json::from_slice(&bytes).map_err(error)?;
+        if s.schema!=SCHEMA || s.url!=e.url {return Err("Saved copy does not match this entry".into());}
+        validate_document(&s.document)?;validate_media(&s.media)?;
+        validate_references(&s.document, &s.media, s.missing_images)?;
+        if s.notices.len()>32 || s.notices.iter().any(|n|!text_ok(n,512)) {return Err("Invalid saved-copy notices".into());}
+        let images=decode_images(&s.media)?;
+        Ok(Reply::Opened{entry:e,snapshot:s,images})
+    }
+}
+fn validate_position(p:&Position)->Result<()> {
+    if p.block.is_some_and(|b|b as usize>=MAX_BLOCKS) || p.offset as usize>MAX_TEXT || (!p.block_hash.is_empty()&&!identifier(&p.block_hash,64)){return Err("Invalid reading anchor".into());}
+    if !identifier(&p.snapshot,64)||!p.fraction.is_finite()||!(0.0..=1.0).contains(&p.fraction)||!text_ok(&p.quote,1024)||!text_ok(&p.before,256)||!text_ok(&p.after,256) {return Err("Invalid reading position".into());}
+    Ok(())
+}
