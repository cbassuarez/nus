+//! Reading List's native full-window surface. The underlying workspace is left
+//! intact. Esc returns to it; saved articles never create a hidden CEF browser.
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::rc::{Rc,Weak};
+use std::sync::mpsc::{Receiver,TryRecvError};
+use std::time::{Duration,Instant};
+use nus_render::{Rect,Scene,Style};
+use winit::event::{ElementState,MouseButton,MouseScrollDelta,WindowEvent};
+use winit::keyboard::{Key,NamedKey};
+use crate::app::{App,Pane};
+use crate::reading::{self,Change,Command,Entry,Listing,Position,ReadState,Reply,Service,Snapshot,Ticket};
+use crate::reading_reader::{Hit as ReaderHit,Picture};
+
+pub const SAVE_MENU_ID:i32=-47001;
+pub const LIST_MENU_ID:i32=-47002;
+const CAPTURE_JS:&str=include_str!("../assets/reading/capture.js");
+
+#[derive(Clone,Debug,PartialEq,Eq)]
+pub enum Act {
+    Close, Back, Search, Find, Next(bool), Filter(u8), Save,
+    Open(String), Original(String), Read(String,bool), Archive(String,bool),
+    Remove(String), Confirm(String), Cancel, Undo(String), Refresh(String),
+    Copy, Smaller, Larger, Link(String), Code(usize),
+}
+#[derive(Clone)]
+pub struct Control {pub key:String,pub rect:Rect,pub label:String,pub act:Act,pub selected:bool}
+#[derive(Clone)]
+struct Source {
+    tab:u64,right:bool,shared:Weak<RefCell<crate::browser::Shared>>,
+    epoch:u64,url:String,title:String,container:String,
+}
+struct CaptureJob {source:Source,ticket:Ticket,request:i32,since:Instant}
+enum Purpose {List,Save(Source),Open(u64),Update,Position(String,Position),Remove(String),Restore}
+struct Pending {rx:Receiver<reading::Result<Reply>>,purpose:Purpose}
+struct View {
+    entry:Entry,reader:crate::reader::Reader,resume:Option<Position>,
+    position_dirty:Option<Instant>,last_position:Option<Position>,note:String,
+}
+#[derive(Default)]
+struct FilterCache {revision:u64,query:String,filter:u8,indices:Vec<usize>}
+
+pub struct State {
+    pub open:bool,
+    service:Option<Service>,pending:Vec<Pending>,captures:Vec<CaptureJob>,finalizers:Vec<Command>,
+    pub listing:Listing,pub query:String,pub filter:u8,pub selected:Option<String>,
+    scroll:f32,max_scroll:f32,list_rect:Option<Rect>,row_height:f32,
+    view:Option<View>,pub controls:Vec<Control>,focus:Option<String>,
+    pub status:String,confirm:Option<String>,undo:Option<String>,
+    last_poll:Option<Instant>,open_generation:u64,reading_scale:f32,
+    press:Option<(f32,f32)>,touch:Option<(u64,f32,f32,bool)>,
+    access_ids:HashMap<String,u64>,next_access_id:u64,
+    filter_cache:RefCell<FilterCache>,
+}
+impl Default for State {
+    fn default()->Self {
+        Self{open:false,service:None,pending:vec![],captures:vec![],finalizers:vec![],listing:Default::default(),
+            query:String::new(),filter:0,selected:None,scroll:0.0,max_scroll:0.0,list_rect:None,row_height:80.0,
+            view:None,controls:vec![],focus:None,status:String::new(),confirm:None,undo:None,last_poll:None,
+            open_generation:0,reading_scale:1.0,press:None,touch:None,access_ids:HashMap::new(),next_access_id:1u64<<48,filter_cache:Default::default()}
+    }
+}
+impl State {
+    fn request(&mut self,command:Command,purpose:Purpose)->reading::Result<()> {
+        let finalizer=matches!(&command,Command::Commit{..}|Command::Fail{..});
+        if !finalizer&&self.pending.len()>=32 {return Err("Reading List is busy; try again".into());}
+        let service=self.service.as_ref().ok_or("Reading List is not open")?;
+        match service.submit_recover(command) {
+            Ok(rx)=>self.pending.push(Pending{rx,purpose}),
+            Err((command,_)) if finalizer=>self.finalizers.push(command),
+            Err((_,error))=>return Err(error),
+        }
+        Ok(())
+    }
+    fn retry_finalizers(&mut self) {
+        let Some(service)=&self.service else{return;};
+        for command in std::mem::take(&mut self.finalizers) {
+            match service.submit_recover(command) {
+                Ok(rx)=>self.pending.push(Pending{rx,purpose:Purpose::Update}),
+                Err((command,error))=>{self.status=error;self.finalizers.push(command);},
+            }
+        }
+    }
+    pub fn entries(&self)->Vec<&Entry> {
+        let mut cache=self.filter_cache.borrow_mut();
+        if cache.revision!=self.listing.revision||cache.query!=self.query||cache.filter!=self.filter {
+            let words:Vec<_>=self.query.split_whitespace().map(str::to_lowercase).collect();
+            let mut indices:Vec<_>=self.listing.entries.iter().enumerate().filter(|(_,e)|match self.filter {
+                0=>!e.archived&&e.read!=ReadState::Finished,1=>!e.archived,2=>!e.archived&&e.read==ReadState::Finished,_=>e.archived,
+            }).filter(|(_,e)| {
