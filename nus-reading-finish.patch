+impl App {
+    /// Semantic steps for the existing native screenshot driver. These commands
+    /// inspect the real feature, never seed an already-complete reading record.
+    /// They are unavailable unless the explicit, isolated NUS_SHOT harness is on.
+    pub(crate) fn reading_check(&mut self, step:&str) {
+        assert!(std::env::var_os("NUS_SHOT").is_some(),"Reading checks require NUS_SHOT");
+        let (verb,rest)=step.split_once(' ').unwrap_or((step,""));
+        match verb {
+            "open"=>self.run(crate::app::Action::ReadingList),
+            "save"=>self.run(crate::app::Action::SaveReading),
+            "close"=>self.reading_action(Act::Close),
+            "back"=>self.reading_action(Act::Back),
+            "click"=>{
+                let control=self.reading.controls.iter().find(|c|c.key==rest).cloned().unwrap_or_else(||panic!("Reading control not visible: {rest}"));
+                self.reading_click(control.rect.x+control.rect.w*0.5,control.rect.y+control.rect.h*0.5);
+            },
+            "select"=>{
+                let index:usize=rest.parse().expect("reading select index");
+                let id=self.reading.entries().get(index).expect("reading entry").id.clone();
+                self.reading.selected=Some(id);
+            },
+            "open-selected"=>{
+                let id=self.reading.selected.clone().expect("selected reading entry");
+                self.reading_action(Act::Open(id));
+            },
+            "scroll"=>self.reading_scroll(0.0,-rest.parse::<f32>().expect("reading scroll amount")*self.scale),
+            "flush"=>self.reading.flush_position(),
+            "find"=>{
+                self.reading_action(Act::Find);
+                *self.reading.view.as_mut().unwrap().reader.saved.find.as_mut().unwrap()=rest.into();
+                self.reading_action(Act::Next(true));
+            },
+            "complete"=>eprintln!("READING_CHECK_COMPLETE"),
+            "assert-count"=>assert_eq!(self.reading.listing.entries.len(),rest.parse::<usize>().unwrap()),
+            "assert-matches"=>assert_eq!(self.reading.entries().len(),rest.parse::<usize>().unwrap()),
+            "assert-idle"=>{assert!(self.reading.captures.is_empty()&&self.reading.finalizers.is_empty());assert!(self.reading.listing.busy.is_empty(),"capture still busy");},
+            "assert-offline"=>assert!(self.reading.listing.entries.iter().all(|e|e.snapshot.is_some()),"not all entries have saved copies"),
+            "assert-reader"=>assert!(self.reading.view.is_some(),"saved reader did not open"),
+            "assert-images"=>assert_eq!(self.reading.view.as_ref().unwrap().reader.saved.pictures.len(),rest.parse::<usize>().unwrap()),
+            "assert-contains"=>assert!(self.reading.view.as_ref().unwrap().reader.article.plain().contains(rest),"missing article text: {rest}"),
+            "assert-find"=>assert!(self.reading.view.as_ref().unwrap().reader.saved.found.is_some(),"saved article find did not locate the text"),
+            "assert-position"=>assert!(self.reading.view.as_ref().unwrap().reader.scroll>0.0,"reading position was not restored"),
+            "assert-code"=>{
+                let expected:String=serde_json::from_str(rest).expect("JSON code string");
+                assert!(self.reading.view.as_ref().unwrap().reader.saved.code.values().any(|s|s==&expected),"exact code content changed");
+            },
+            "assert-browsers"=>assert_eq!(crate::browser::live_count(),rest.parse::<usize>().unwrap(),"saved reader unexpectedly needs a live CEF browser"),
+            "assert-bounds"=>{
+                let(w,h)=(self.target.size.0 as f32,self.target.size.1 as f32);
+                for c in &self.reading.controls {assert!(c.rect.x>=0.0&&c.rect.y>=0.0&&c.rect.right()<=w+1.0&&c.rect.bottom()<=h+1.0,"control escaped the window: {} {:?}",c.key,c.rect);}
+            },
+            "assert-access"=>{
+                let tree=self.reading_access_tree();
+                assert!(tree.nodes.len()>2,"missing reading accessibility tree");
+                let mut ids=std::collections::HashSet::new();
+                assert!(tree.nodes.iter().all(|(id,_)|ids.insert(id.0)),"duplicate accessibility node identity");
+            },
+            "close-source"=>{
+                self.reading_action(Act::Close);
+                let tab=&self.tabs[self.active];
+                let pane=if tab.focus_right {tab.right.as_ref().unwrap_or(&tab.left)}else{&tab.left};
+                assert!(matches!(pane,Pane::Web(_)),"source page is not focused");
+                self.run(crate::app::Action::CloseTab);
+            },
+            _=>panic!("Unknown reading check: {step}"),
+        }
+        self.dirty=true;
+    }
+}
