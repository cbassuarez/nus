+/* Called with the shared extractor's JSON and a native-generated capture token.
+ * It reads only images already decoded by this page. Canvas tainting enforces
+ * the origin boundary. No fetch fallback, credentials copied, or network I/O.
+ */
+(function (token, articleJSON) {
+  'use strict';
+  const article = JSON.parse(articleJSON);
+  const media = [], notices = new Set();
+  let missing = 0, total = 0, pixels = 0;
+  const saved = new Map();
+  const byURL = new Map();
+  for (const img of document.images) {
+    const src = img.currentSrc || img.src;
+    if (src && img.complete && img.naturalWidth && !byURL.has(src)) byURL.set(src, img);
+  }
+  for (const block of article.blocks) {
+    if (block.t !== 'img') continue;
+    const original = block.src;
+    block.src = ''; // No external URL survives as an offline image source.
+    if (saved.has(original)) { block.src = saved.get(original); continue; }
+    const img = byURL.get(original);
+    let canvas;
+    try {
+      if (!img || media.length >= 24) throw new Error('unavailable');
+      const w = img.naturalWidth, h = img.naturalHeight;
+      if (w > 4096 || h > 4096 || w * h > 4194304 || pixels + w * h > 8388608) throw new Error('oversized');
+      canvas = document.createElement('canvas');
+      canvas.width = w; canvas.height = h;
+      const ctx = canvas.getContext('2d');
+      if (!ctx) throw new Error('canvas unavailable');
+      ctx.drawImage(img, 0, 0);
+      const url = canvas.toDataURL('image/png');
+      const comma = url.indexOf(',');
+      if (!url.startsWith('data:image/png;base64,') || comma < 0 || url.length > 1400000) throw new Error('oversized');
+      const bytes = atob(url.slice(comma + 1));
+      if (bytes.length > 1048576 || total + bytes.length > 4194304) throw new Error('budget');
+      const hex = new Array(bytes.length);
+      for (let i = 0; i < bytes.length; i++) hex[i] = bytes.charCodeAt(i).toString(16).padStart(2, '0');
+      const id = 'image-' + media.length;
+      media.push({ id, width: w, height: h, png: hex.join('') });
+      total += bytes.length; pixels += w * h;
+      saved.set(original, id);
+      block.src = id;
+    } catch (_) {
+      missing++;
+      notices.add('Some images could not be saved without another network request or crossing an origin boundary. Their alternative text is retained.');
+    } finally {
+      if (canvas) canvas.width = canvas.height = 0;
+    }
+  }
+  return JSON.stringify({ schema: 1, token, url: location.href, document: article, media, missing_images: missing, notices: Array.from(notices) });
+})
diff --git a/spikes/composite/src/reading.rs b/spikes/composite/src/reading.rs
new file mode 100644
--- /dev/null
+++ b/spikes/composite/src/reading.rs
@@ -0,0 +1,661 @@
+//! Reading List: one profile-scoped writer, immutable snapshots, explicit intent.
+//!
+//! No network APIs and no GUI dependencies live here. A saved URL is committed
+//! before capture starts; failure to capture never destroys an existing copy.
+//! UI code submits operations to Service; it must not rewrite stale entry lists.
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, HashMap};
+use std::fs::{self, File};
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+use std::sync::{mpsc, Mutex, OnceLock};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+pub const SCHEMA: u32 = 1;
+pub const MAX_CAPTURE: usize = 12 * 1024 * 1024;
+pub const MAX_TEXT: usize = 2 * 1024 * 1024;
+pub const MAX_BLOCKS: usize = 4096;
+pub const MAX_MEDIA: usize = 24;
+pub const MAX_PNG: usize = 1024 * 1024;
+pub const MAX_MEDIA_TOTAL: usize = 4 * 1024 * 1024;
+pub const MAX_PIXELS_TOTAL: u64 = 8_388_608;
+pub const MAX_ENTRIES: usize = 20_000;
+const MAX_RECORD: usize = 32 * 1024;
+
+pub type Result<T> = std::result::Result<T, String>;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub enum ReadState {
+    #[default]
+    Unread,
+    InProgress,
+    Finished,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+pub struct Position {
+    /// A passage, not a physical scroll coordinate. Matching crosses line wraps.
+    pub quote: String,
+    pub before: String,
+    pub after: String,
+    pub fraction: f32,
+    pub snapshot: String,
+    #[serde(default)]
+    pub block: Option<u32>,
+    #[serde(default)]
+    pub offset: u32,
+    #[serde(default)]
+    pub block_hash: String,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Entry {
+    pub schema: u32,
+    pub id: String,
+    pub revision: u64,
+    pub url: String,
+    pub container: String,
+    pub title: String,
+    pub saved_at: u64,
+    pub updated_at: u64,
+    pub read: ReadState,
+    pub archived: bool,
+    pub snapshot: Option<String>,
+    pub position: Option<Position>,
+    pub capture_error: Option<String>,
+    pub deleted: bool,
+    #[serde(default)]
+    pub word_count: Option<usize>,
+    #[serde(default)]
+    pub missing_images: Option<usize>,
+}
+
+impl Entry {
+    pub fn status(&self) -> &'static str {
+        if self.snapshot.is_none() { "Link saved; no offline copy" } else if self.missing_images.is_some_and(|n|n>0) { "Offline article; images incomplete" } else { "Offline article" }
+    }
+    pub fn host(&self) -> String {
+        url::Url::parse(&self.url).ok().and_then(|u| u.host_str().map(str::to_owned)).unwrap_or_default()
+    }
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Media {
+    /// An opaque identifier generated by the extractor, never a filesystem path.
+    pub id: String,
+    pub width: u32,
+    pub height: u32,
+    /// Hex-encoded PNG re-encoded from an already decoded, origin-clean image.
+    pub png: String,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Capture {
+    pub schema: u32,
+    pub token: String,
+    pub url: String,
+    pub document: serde_json::Value,
+    pub media: Vec<Media>,
+    pub missing_images: usize,
+    pub notices: Vec<String>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Snapshot {
+    pub schema: u32,
+    pub url: String,
+    pub captured_at: u64,
+    pub document: serde_json::Value,
+    pub media: Vec<Media>,
+    pub missing_images: usize,
+    pub notices: Vec<String>,
+}
+
+#[derive(Clone, Debug)]
+pub struct Ticket {
+    pub id: String,
+    pub generation: String,
+    pub url: String,
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct Listing {
+    pub revision: u64,
+    pub entries: Vec<Entry>,
+    /// A damaged record is preserved on disk and reported, never rewritten empty.
+    pub warnings: Vec<String>,
+    pub busy: Vec<String>,
+}
+
+#[derive(Clone, Debug)]
+pub enum Change {
+    Read(ReadState),
+    Archive(bool),
+    Position(Position),
+    Delete,
+    Restore,
+}
+
+#[derive(Debug)]
+pub enum Command {
+    List,
+    ListSince(u64),
+    Save { url: String, title: String, container: String, refresh: bool },
+    Commit { ticket: Ticket, capture: String },
+    Fail { ticket: Ticket, reason: String },
+    Change { id: String, change: Change },
+    Open { id: String },
+    Barrier,
+}
+
+#[derive(Clone, Debug)]
+pub enum Reply {
+    List(Listing),
+    Unchanged,
+    Saved { entry: Entry, ticket: Option<Ticket>, existed: bool },
+    Committed(Entry),
+    Changed(Entry),
+    Opened { entry: Entry, snapshot: Snapshot, images: Vec<DecodedImage> },
+    Stale,
+    Barrier,
+}
+
+fn now() -> u64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_secs()
+}
+fn error(e: impl std::fmt::Display) -> String { e.to_string() }
+fn hex(bytes: &[u8]) -> String { bytes.iter().map(|b| format!("{b:02x}")).collect() }
+pub fn digest(bytes: &[u8]) -> String { hex(ring::digest::digest(&ring::digest::SHA256, bytes).as_ref()) }
+fn random_id() -> Result<String> {
+    let mut b = [0u8; 16];
+    getrandom::fill(&mut b).map_err(error)?;
+    Ok(hex(&b))
+}
+fn identifier(s: &str, n: usize) -> bool { s.len() == n && s.bytes().all(|c| c.is_ascii_hexdigit() && !c.is_ascii_uppercase()) }
+fn text_ok(s: &str, max: usize) -> bool {
+    s.len() <= max && !s.chars().any(|c| c == '\0' || (c.is_control() && c != '\n' && c != '\t' && c != '\r'))
+}
+/// Conservative identity: URL parsing normalizes host/default port only. Query
+/// parameters, fragments, scheme and container all remain significant.
+pub fn page_url(raw: &str) -> Result<String> {
+    if raw.len() > 8192 { return Err("Address is too long".into()); }
+    let u = url::Url::parse(raw).map_err(|_| "Invalid page address".to_string())?;
+    if !matches!(u.scheme(), "https" | "http") || !u.has_host() || !u.username().is_empty() || u.password().is_some() {
+        return Err("Reading List accepts HTTP(S) pages without embedded credentials".into());
+    }
+    Ok(u.to_string())
+}
+
+pub fn decode_hex(s: &str) -> Result<Vec<u8>> {
+    if s.len() > MAX_PNG * 2 || s.len() % 2 != 0 { return Err("Invalid or oversized image".into()); }
+    fn digit(b: u8) -> Option<u8> { match b { b'0'..=b'9' => Some(b-b'0'), b'a'..=b'f' => Some(b-b'a'+10), _ => None } }
+    s.as_bytes().chunks_exact(2).map(|p| Ok(digit(p[0]).ok_or("Invalid image encoding")? * 16 + digit(p[1]).ok_or("Invalid image encoding")?)).collect()
+}
+
+#[derive(Clone, Debug)]
+pub struct DecodedImage { pub id: String, pub width: u32, pub height: u32, pub rgba: Vec<u8> }
+
+fn validate_media(media: &[Media]) -> Result<()> {
+    if media.len() > MAX_MEDIA { return Err("Too many saved images".into()); }
+    let mut total = 0usize;
+    let mut pixels = 0u64;
+    let mut ids = std::collections::HashSet::new();
+    for m in media {
+        if m.id.len() <= 6 || m.id.len() > 32 || !m.id.starts_with("image-") || !m.id[6..].bytes().all(|b|b.is_ascii_digit()) || !ids.insert(&m.id) {
+            return Err("Invalid image identity".into());
+        }
+        if m.width == 0 || m.height == 0 || m.width > 4096 || m.height > 4096 || u64::from(m.width)*u64::from(m.height)>4_194_304 {
+            return Err("Image dimensions exceed the reading budget".into());
+        }
+        pixels += u64::from(m.width) * u64::from(m.height);
+        if pixels > MAX_PIXELS_TOTAL { return Err("Images exceed the total decoded-pixel budget".into()); }
+        let b = decode_hex(&m.png)?;
+        total = total.checked_add(b.len()).ok_or("Image size overflow")?;
+        if total > MAX_MEDIA_TOTAL || b.len() < 33 || &b[..8] != b"\x89PNG\r\n\x1a\n" || &b[12..16] != b"IHDR" {
+            return Err("Invalid or oversized PNG payload".into());
+        }
+        let w = u32::from_be_bytes(b[16..20].try_into().map_err(error)?);
+        let h = u32::from_be_bytes(b[20..24].try_into().map_err(error)?);
+        if (w,h)!=(m.width,m.height) { return Err("Image dimensions do not match their manifest".into()); }
+    }
+    Ok(())
+}
+
+/// Decode only the explicitly supported PNG representation, with per-image and
+/// aggregate limits. These calls run on the storage worker, never while painting.
+fn decode_images(media: &[Media]) -> Result<Vec<DecodedImage>> {
+    validate_media(media)?;
+    let mut out=Vec::new();
+    for m in media {
+        let bytes=decode_hex(&m.png)?;
+        let mut reader=image::ImageReader::with_format(std::io::Cursor::new(bytes), image::ImageFormat::Png);
+        let mut limits=image::Limits::default();
+        limits.max_image_width=Some(4096);
+        limits.max_image_height=Some(4096);
+        limits.max_alloc=Some(64 * 1024 * 1024);
+        reader.limits(limits);
+        let decoded=reader.decode().map_err(|_|"A saved image could not be decoded".to_string())?;
+        if (decoded.width(),decoded.height())!=(m.width,m.height) {return Err("Decoded image dimensions differ from the manifest".into());}
+        out.push(DecodedImage{id:m.id.clone(),width:m.width,height:m.height,rgba:decoded.into_rgba8().into_raw()});
+    }
+    Ok(out)
+}
+
+fn validate_references(document:&serde_json::Value, media:&[Media], missing:usize)->Result<()> {
+    let ids:std::collections::HashSet<_>=media.iter().map(|m|m.id.as_str()).collect();
+    let mut absent=0usize;
+    let mut used=std::collections::HashSet::new();
+    for b in document["blocks"].as_array().ok_or("Missing article blocks")? {
+        if b["t"]!="img" {continue;}
+        let id=b["src"].as_str().unwrap_or("");
+        if id.is_empty() {absent+=1;} else if ids.contains(id) {used.insert(id);} else {return Err("Saved image reference is missing its payload".into());}
+    }
+    if absent!=missing || used.len()!=ids.len() {return Err("Image completeness does not match the saved article".into());}
+    Ok(())
+}
+
+pub fn validate_document(v: &serde_json::Value) -> Result<()> {
+    let o=v.as_object().ok_or("Article is not an object")?;
+    for name in ["title","byline","when"] {
+        let s=o.get(name).and_then(|v|v.as_str()).ok_or("Missing article metadata")?;
+        if !text_ok(s, 8192) { return Err("Invalid article metadata".into()); }
+    }
+    let blocks=o.get("blocks").and_then(|v|v.as_array()).ok_or("Missing article blocks")?;
+    if blocks.is_empty() || blocks.len()>MAX_BLOCKS { return Err("Empty or oversized article".into()); }
+    let mut size=0usize;
+    let mut prose=0usize;
+    for b in blocks {
+        let t=b.get("t").and_then(|v|v.as_str()).ok_or("Missing block type")?;
+        if !matches!(t,"h"|"p"|"pre"|"li"|"q"|"img"|"cap"|"link") { return Err("Unsupported article block".into()); }
+        let x=b.get("x").and_then(|v|v.as_str()).ok_or("Missing block text")?;
+        if !text_ok(x, MAX_TEXT) {return Err("Invalid block text".into());}
+        size=size.checked_add(x.len()).ok_or("Article size overflow")?;
+        if size>MAX_TEXT {return Err("Article exceeds the text budget; no truncated copy was saved".into());}
+        if matches!(t,"p"|"li"|"q"|"pre") {prose+=x.trim().chars().count();}
+        if t=="h" && !b.get("l").and_then(|v|v.as_u64()).is_some_and(|l|(1..=6).contains(&l)) {return Err("Invalid heading level".into());}
+        if t=="img" {
+            let id=b.get("src").and_then(|v|v.as_str()).unwrap_or("");
+            if !id.is_empty() && (id.len()<=6 || id.len()>32 || !id.starts_with("image-") || !id[6..].bytes().all(|b|b.is_ascii_digit())) {return Err("Invalid image reference".into());}
+        }
+        if t=="link" {page_url(b.get("src").and_then(|v|v.as_str()).ok_or("Missing link address")?)?;}
+    }
+    if prose<80 {return Err("Not enough article text; the link is still saved".into());}
+    Ok(())
+}
+
+fn read_limited(path: &Path, limit: usize) -> Result<Vec<u8>> {
+    let meta=fs::symlink_metadata(path).map_err(error)?;
+    if !meta.is_file() || meta.file_type().is_symlink() || meta.len()>limit as u64 {return Err("Invalid or oversized reading file".into());}
+    let mut b=Vec::new();
+    File::open(path).map_err(error)?.take(limit as u64+1).read_to_end(&mut b).map_err(error)?;
+    if b.len()>limit {return Err("Reading file exceeds its size limit".into());}
+    Ok(b)
+}
+
+/// New bytes are synchronized before publication. On Unix, the containing
+/// directory is synchronized as well. This does not promise survival of a
+/// failed disk/controller; immutable objects keep old snapshots recoverable.
+fn durable_write(path: &Path, bytes: &[u8]) -> Result<()> {
+    let parent=path.parent().ok_or("Missing reading directory")?;
+    let mut f=tempfile::NamedTempFile::new_in(parent).map_err(error)?;
+    f.write_all(bytes).map_err(error)?;
+    f.as_file().sync_all().map_err(error)?;
+    f.persist(path).map_err(error)?;
+    #[cfg(unix)]
+    File::open(parent).and_then(|d| d.sync_all()).map_err(error)?;
+    Ok(())
+}
