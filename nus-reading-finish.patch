+impl Drop for State {
+    fn drop(&mut self) {
+        self.flush_position();
+        self.retry_finalizers();
+        if let Some(service)=&self.service {
+            // Complete accepted record operations before this window disappears.
+            // Failed/closed windows must not strand another window's capture badge.
+            if let Err(e)=service.flush(){tracing::warn!("Reading List shutdown: {e}");}
+            for p in &self.pending {
+                if let Ok(Ok(Reply::Saved{ticket:Some(t),..}))=p.rx.try_recv(){let _=service.submit(Command::Fail{ticket:t,reason:"The source window closed before capture".into()});}
+            }
+            if !self.finalizers.is_empty(){tracing::warn!("Reading List closed with {} capture results still queued; saved links and previous snapshots remain intact",self.finalizers.len());}
+            for job in &self.captures {
+                if let Some(shared)=job.source.shared.upgrade(){let mut s=shared.borrow_mut();s.reading_requests.remove(&job.request);s.reading_results.remove(&job.request);}
+                let _=service.submit(Command::Fail{ticket:job.ticket.clone(),reason:"The source window closed before capture completed".into()});
+            }
+            if let Err(e)=service.flush(){tracing::warn!("Reading List shutdown: {e}");}
+        }
+    }
+}
