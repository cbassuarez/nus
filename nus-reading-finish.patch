+            node.set_label(control.label);let r=control.rect;node.set_bounds(accesskit::Rect{x0:r.x as f64,y0:r.y as f64,x1:r.right() as f64,y1:r.bottom() as f64});
+            node.add_action(Action::Click);node.add_action(Action::Focus);
+            if field{node.add_action(Action::SetValue);node.set_value(if control.key=="search"{self.reading.query.clone()}else{self.reading.view.as_ref().and_then(|v|v.reader.saved.find.clone()).unwrap_or_default()});}
+            else if control.key.starts_with("entry:")||control.key.starts_with("filter:"){node.set_selected(control.selected);}
+            if self.reading.focus.as_deref()==Some(control.key.as_str()){focus=id;}
+            nodes.push((id,node));children.push(id);
+        }
+        if self.reading.confirm.is_none(){
+            if let Some(v)=&self.reading.view{
+                let entry_id=v.entry.id.clone();
+                let blocks=v.reader.article.blocks.clone();let title=v.entry.title.clone();
+                let mut article_children=Vec::new();
+                for(i,block)in blocks.into_iter().enumerate(){
+                    use crate::reader::Block;
+                    let (label,role)=match block{Block::Heading(_,s)=>(s,Role::Heading),Block::Image(alt,_)=>(format!("Image: {alt}"),Role::Image),Block::Link(text,url)=>(format!("{text}: {url}"),Role::Label),Block::Para(s)|Block::Pre(s)|Block::Item(s)|Block::Quote(s)|Block::Caption(s)=>(s,Role::Label)};
+                    let id=NodeId(self.reading.node_id(&format!("article:{entry_id}:{i}")));let mut n=Node::new(role);n.set_label(label);nodes.push((id,n));article_children.push(id);
+                }
+                let id=NodeId(3);let mut n=Node::new(Role::Document);n.set_label(title);n.set_children(article_children);n.add_action(Action::Focus);nodes.push((id,n));children.push(id);
+                if self.reading.focus.as_deref()==Some("article"){focus=id;}
+            }
+        }
+        let mut dialog=Node::new(Role::Dialog);dialog.set_label(if self.reading.confirm.is_some(){"Confirm removal"}else{"Reading List"});dialog.set_modal();dialog.set_children(children);nodes.push((NodeId(2),dialog));
+        let mut root=Node::new(Role::Window);root.set_label("nus — Reading List");root.set_children(vec![NodeId(2)]);nodes.push((NodeId(1),root));
+        let mut info=TreeInfo::new(NodeId(1));info.toolkit_name=Some("nus".into());TreeUpdate{nodes,tree:Some(info),tree_id:TreeId::ROOT,focus}
+    }
+    pub(crate) fn reading_access_action(&mut self,request:accesskit::ActionRequest) {
+        use accesskit::{Action,ActionData};
+        if request.target_node.0==3&&request.action==Action::Focus{self.reading.focus=Some("article".into());self.dirty=true;return;}
+        let key=self.reading.access_ids.iter().find(|(_,id)|**id==request.target_node.0).map(|(key,_)|key.clone());
+        let Some(control)=key.and_then(|key|self.reading.controls.iter().find(|c|format!("control:{}:{:?}",c.key,c.act)==key).cloned()) else{return;};
+        match request.action{
+            Action::Click=>self.reading_action(control.act),
+            Action::Focus=>self.reading.focus=Some(control.key),
+            Action::SetValue=>if let Some(ActionData::Value(value))=request.data{
+                let value:String=value.chars().take(512).collect();
+                if control.key=="search"{self.reading.query=value;self.reading.scroll=0.0;self.reading.selected=self.reading.entries().first().map(|e|e.id.clone());}
+                else if control.key=="find"{if let Some(v)=&mut self.reading.view{v.reader.saved.find=Some(value);v.reader.saved.found=None;}}
+            },_=>{}
+        }self.dirty=true;
+    }
+}
