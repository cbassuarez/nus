+                    self.saved.drawn.push((index,Rect::new(x,y-st.px*1.05,text_w,st.px*1.45),st));
+                    if let Some(url)=self.saved.links.get(&index) {
+                        scene.hline(x,y+px(3.0),text_w,px(1.0),signal);
+                        self.saved.hits.push((hit,crate::reading_reader::Hit::Link(url.clone())));
+                    }
+                }
+            }
         }
         scene.layer(None);
